pipeline {
    agent any

    environment {

        BUILD_PATH = "dist\\car_website\\browser"

        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"

        DEPLOY_PATH = "/usr/share/nginx/html/car"

        REMOTE_BACKUP = "/home/ec2-user/car_backups"

        LOCAL_BACKUP = "C:\\jenkins_backups\\car"

        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat "npx ng build --configuration production --base-href=/car/"
            }
        }

        stage('Verify Build') {
            steps {
                bat "dir %BUILD_PATH%"
            }
        }

        stage('Create Local Backup') {
            steps {
                bat """
                if not exist "%LOCAL_BACKUP%" mkdir "%LOCAL_BACKUP%"

                set VERSION=1
                :loop
                if exist "%LOCAL_BACKUP%\\car%VERSION%" (
                    set /a VERSION+=1
                    goto loop
                )

                mkdir "%LOCAL_BACKUP%\\car%VERSION%"
                xcopy "%BUILD_PATH%\\*" "%LOCAL_BACKUP%\\car%VERSION%\\" /E /I /Y
                """
            }
        }

        stage('Deploy to AWS Nginx') {
            steps {
                sshagent(['ec2-ssh']) {
                    bat """
                    echo ===== DEPLOYING TO AWS =====

                    REM 1. Create backup folder on EC2
                    ssh %EC2_USER%@%EC2_IP% "mkdir -p %REMOTE_BACKUP%"

                    REM 2. Clear old deployment
                    ssh %EC2_USER%@%EC2_IP% "rm -rf %DEPLOY_PATH%/*"

                    REM 3. Upload new build
                    scp -r %BUILD_PATH%/. %EC2_USER%@%EC2_IP%:%DEPLOY_PATH%/

                    REM 4. Restart nginx
                    ssh %EC2_USER%@%EC2_IP "sudo systemctl restart nginx || systemctl restart nginx"

                    echo ===== DEPLOYMENT DONE =====
                    """
                }
            }
        }
    }

    post {
        success {
            emailext(
                to: "${EMAIL_TO}",
                subject: "SUCCESS: AWS Deployment Complete",
                body: "Angular app deployed successfully to AWS Nginx"
            )
        }

        failure {
            emailext(
                to: "${EMAIL_TO}",
                subject: "FAILED: AWS Deployment",
                body: "Check Jenkins logs for errors"
            )
        }
    }
}
