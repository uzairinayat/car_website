pipeline {
    agent any

    environment {
        TOMCAT_HOME = "C:\\Program Files\\Apache Software Foundation\\Tomcat 9.0"
        DEPLOY_PATH = "${TOMCAT_HOME}\\webapps\\car"

        BUILD_PATH = "dist\\car_website\\browser"

        BACKUP_ROOT = "C:\\jenkins_backups\\car"

        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat "npx ng build --configuration production --base-href=/car/"
            }
        }

        stage('Create Versioned Backup + Deploy') {
            steps {
                bat """
                setlocal enabledelayedexpansion

                REM Find next version number
                set VERSION=1

                :loop
                if exist "%BACKUP_ROOT%\\car!VERSION!" (
                    set /a VERSION+=1
                    goto loop
                )

                REM Create backup folder
                mkdir "%BACKUP_ROOT%\\car!VERSION!"

                REM Backup old deployment if exists
                if exist "%DEPLOY_PATH%" (
                    xcopy "%DEPLOY_PATH%\\*" "%BACKUP_ROOT%\\car!VERSION!\\" /E /I /Y
                    rmdir /s /q "%DEPLOY_PATH%"
                )

                REM Deploy new build
                xcopy "%BUILD_PATH%\\*" "%DEPLOY_PATH%\\" /E /I /Y

                endlocal
                """
            }
        }

        stage('Restart Tomcat') {
            steps {
                bat """
                net stop Tomcat9
                net start Tomcat9
                """
            }
        }
    }

    post {
        success {
            emailext(
                to: "${EMAIL_TO}",
                subject: "SUCCESS: Build Deployed",
                body: "New build deployed and backup created in C:\\jenkins_backups"
            )
        }

        failure {
            emailext(
                to: "${EMAIL_TO}",
                subject: "FAILED: Deployment",
                body: "Pipeline failed. Check Jenkins logs."
            )
        }
    }
}
