pipeline {
    agent any

    environment {
        BUILD_PATH = "dist\\car_website\\browser"
        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"
        KEY_PATH = "C:\\jenkins\\.ssh\\ec2-key.pem"
        DEPLOY_PATH = "/usr/share/nginx/html/car"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build') {
            steps {
                bat 'npx ng build --configuration production --base-href=/car/'
            }
        }

        stage('Verify Build') {
            steps {
                bat 'dir dist\\car_website\\browser'
            }
        }

        stage('Deploy to EC2') {
            steps {
                bat """
                echo Deploying to EC2...

                REM 1. Clear old files
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP% "rm -rf %DEPLOY_PATH%/*"

                REM 2. Upload new build
                scp -i "%KEY_PATH%" -o StrictHostKeyChecking=no -r %BUILD_PATH%/. %EC2_USER%@%EC2_IP%:%DEPLOY_PATH%/

                REM 3. Restart nginx
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP% "sudo systemctl restart nginx || systemctl restart nginx"
                """
            }
        }
    }

    post {
        success {
            emailext to: 'uzairinayat42@gmail.com',
                     subject: 'SUCCESS: AWS Deploy',
                     body: 'Deployment successful'
        }

        failure {
            emailext to: 'uzairinayat42@gmail.com',
                     subject: 'FAILED: AWS Deploy',
                     body: 'Check Jenkins logs'
        }
    }
}
