pipeline {
    agent any
    environment {
        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"
        DEPLOY_PATH = "/usr/share/nginx/html"
        BUILD_OUTPUT = "dist/car_website/browser"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }
        stage('Install Dependencies') {
            steps {
                bat 'npm ci'
            }
        }
        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying to EC2...'
                sshagent(['ec2-ssh']) {
                    bat """
                    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=NUL %EC2_USER%@%EC2_IP% "mkdir -p /tmp/deploy_%BUILD_NUMBER%"
                    scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=NUL -r %BUILD_OUTPUT% %EC2_USER%@%EC2_IP%:/tmp/deploy_%BUILD_NUMBER%/
                    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=NUL %EC2_USER%@%EC2_IP% "sudo rm -rf %DEPLOY_PATH%/* && sudo cp -r /tmp/deploy_%BUILD_NUMBER%/browser/* %DEPLOY_PATH%/ && sudo rm -rf /tmp/deploy_%BUILD_NUMBER% && sudo systemctl reload nginx"
                    """
                }
            }
        }
    }
    post {
        success {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: 'Deployment Success 🚀',
                body: 'car_website deployed successfully on EC2'
            )
        }
        failure {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: 'Deployment Failed ❌',
                body: 'Check Jenkins logs'
            )
        }
    }
}
