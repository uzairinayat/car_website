pipeline {
    agent any

    environment {
        BUILD_PATH = "dist\\car_website\\browser"

        // AWS CONFIG
        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"
        KEY_PATH = "C:\\jenkins\\.ssh\\ec2-key.pem"

        // SERVER PATHS
        DEPLOY_PATH = "/usr/share/nginx/html/car"
        REMOTE_BACKUP = "/home/ec2-user/car_backups"

        // LOCAL BACKUP
        BACKUP_ROOT = "C:\\jenkins_backups\\car"

        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat "npx ng build --configuration production --base-href=/car/"
            }
        }

        stage('Verify Build') {
            steps {
                bat "dir %BUILD_PATH%"
            }
        }

        // ✅ LOCAL BACKUP (same as your logic, improved)
        stage('Local Backup') {
            steps {
                bat """
                setlocal enabledelayedexpansion

                if not exist "%BACKUP_ROOT%" mkdir "%BACKUP_ROOT%"

                set VERSION=1
                :loop
                if exist "%BACKUP_ROOT%\\car!VERSION!" (
                    set /a VERSION+=1
                    goto loop
                )

                mkdir "%BACKUP_ROOT%\\car!VERSION!"
                xcopy "%BUILD_PATH%\\*" "%BACKUP_ROOT%\\car!VERSION!\\" /E /I /Y

                endlocal
                """
            }
        }

        // ✅ DEPLOY TO AWS (MAIN FIX)
        stage('Deploy to AWS Nginx') {
            steps {
                bat '''
                echo Connecting to AWS...

                REM 1. Create backup on EC2
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP% "
                    mkdir -p %REMOTE_BACKUP%/car_$(date +%Y%m%d_%H%M%S)
                    cp -r %DEPLOY_PATH%/* %REMOTE_BACKUP%/car_$(date +%Y%m%d_%H%M%S)/ 2>/dev/null || true
                "

                REM 2. Clean old deployment
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP% "
                    sudo rm -rf %DEPLOY_PATH%/*
                "

                REM 3. Upload new build
                scp -i "%KEY_PATH%" -o StrictHostKeyChecking=no -r %BUILD_PATH%/. %EC2_USER%@%EC2_IP%:%DEPLOY_PATH%/

                REM 4. Restart nginx
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP% "
                    sudo systemctl restart nginx
                "
                '''
            }
        }
    }

    post {
        success {
            emailext(
                to: "${EMAIL_TO}",
                subject: "SUCCESS: AWS Nginx Deployment",
                body: "Build deployed successfully with backups (local + EC2)"
            )
        }

        failure {
            emailext(
                to: "${EMAIL_TO}",
                subject: "FAILED: Deployment",
                body: "Check Jenkins logs"
            )
        }
    }
}
