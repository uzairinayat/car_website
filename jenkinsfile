pipeline {
    agent any

   environment {
    DEPLOY_SERVER = "root@10.1.1.221"
    TOMCAT_PATH = "/root/Desktop/apache-tomcat-9.0.20/webapps"
    APP_NAME = "ROOT"
    BACKUP_PATH = "/root/Desktop/backup_ROOT"
}

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo 'Cloning latest code from GitHub...'
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing npm dependencies...'
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                echo 'Building Angular project...'
                bat 'npm run build -- --configuration production'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                bat 'npm run test -- --watch=false --browsers=ChromeHeadless'
            }
        }

        stage('Backup Current Deployment') {
          steps {
              echo 'Backing up current Tomcat deployment...'
      
              bat """
              ssh %DEPLOY_SERVER% "rm -rf %BACKUP_PATH% && cp -r %TOMCAT_PATH%/%APP_NAME% %BACKUP_PATH%"
              """
          }
        }

       stage('Deploy to Tomcat') {
          steps {
              echo 'Deploying build to Tomcat webapps ROOT...'
      
              bat """
              ssh %DEPLOY_SERVER% "rm -rf %TOMCAT_PATH%/%APP_NAME%"
              scp -r dist\\car_website\\browser\\* %DEPLOY_SERVER%:%TOMCAT_PATH%/%APP_NAME%
              """
          }
      }

       stage('Verify Deployment') {
          steps {
              echo 'Verifying deployment...'
      
              bat """
              ssh %DEPLOY_SERVER% "test -f %TOMCAT_PATH%/%APP_NAME%/index.html"
              """
          }
      }

    post {

        success {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: "✅ SUCCESS: Jenkins Build #${env.BUILD_NUMBER}",
                body: """
Pipeline Status: SUCCESS

✔ Build completed successfully
✔ Deployment done on server
✔ Tests passed

Build Number: ${env.BUILD_NUMBER}
Job: ${env.JOB_NAME}
"""
            )
        }

        failure {
          script {
              echo "Rollback started..."
      
              bat """
              ssh %DEPLOY_SERVER% "rm -rf %TOMCAT_PATH%/%APP_NAME% && cp -r %BACKUP_PATH% %TOMCAT_PATH%/%APP_NAME%"
              """
          }
      
          emailext(
              to: 'uzairinayat42@gmail.com',
              subject: "❌ FAILED + ROLLBACK: Build #${env.BUILD_NUMBER}",
              body: """
      Pipeline FAILED
      
      ✔ Rollback executed automatically
      Path restored:
      %TOMCAT_PATH%/%APP_NAME%
      
      Check logs in Jenkins for error details.
      """
          )
      }
    }
}
