pipeline {
    agent any

    environment {
        EC2_IP = "34.196.168.199"   // 🔁 replace with your EC2 IP
        EC2_USER = "ec2-user"
        DEPLOY_PATH = "/var/www/html"   // Nginx path
        BACKUP_PATH = "/var/www/backups"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Build Angular') {
            steps {
                bat 'npm install'
                bat 'npm run build'
            }
        }

        stage('Prepare Build') {
            steps {
                // Angular build output (browser folder)
                dir('dist') {
                    bat 'dir'
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['ec2-key']) {

                    // Create backup on EC2
                    bat """
                    ssh -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP% ^
                    "mkdir -p %BACKUP_PATH% && \
                    if [ -d %DEPLOY_PATH% ]; then \
                    cp -r %DEPLOY_PATH% %BACKUP_PATH%/backup_\$(date +%Y%m%d_%H%M%S); \
                    fi"
                    """

                    // Remove old files
                    bat """
                    ssh %EC2_USER%@%EC2_IP% "rm -rf %DEPLOY_PATH%/*"
                    """

                    // Upload new build (browser folder only)
                    bat """
                    scp -r -o StrictHostKeyChecking=no dist\\browser\\* %EC2_USER%@%EC2_IP%:%DEPLOY_PATH%/
                    """
                }
            }
        }

        stage('Restart Server (Optional)') {
            steps {
                sshagent(['ec2-key']) {
                    bat """
                    ssh %EC2_USER%@%EC2_IP% "sudo systemctl restart nginx"
                    """
                }
            }
        }
    }
}
