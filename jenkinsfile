pipeline {
    agent any

    environment {
        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying to EC2...'

                bat '''
                scp -i ec2-key.pem -r dist/car_website/browser/* %EC2_USER%@%EC2_IP%:/tmp/

                ssh -i ec2-key.pem %EC2_USER%@%EC2_IP "sudo rm -rf /var/www/html/* && sudo cp -r /tmp/* /var/www/html/ && sudo systemctl restart nginx"
                '''
            }
        }
    }

    post {
        success {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: 'Deployment Success 🚀',
                body: 'car_website deployed successfully on EC2'
            )
        }

        failure {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: 'Deployment Failed ❌',
                body: 'Check Jenkins logs'
            )
        }
    }
}
