pipeline {
    agent any

    environment {
        DEPLOY_SERVER = "root@10.1.1.221"
        DEPLOY_PATH = "/root/Desktop/apache-tomcat-9.0.20/webapps/ROOT1"
        BACKUP_PATH = "/root/Desktop/backup_ROOT1"
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo 'Cloning latest code from GitHub...'
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing npm dependencies...'
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                echo 'Building Angular project...'
                bat 'npm run build -- --configuration production'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                bat 'npm run test -- --watch=false --browsers=ChromeHeadless'
            }
        }

        stage('Backup Current Deployment') {
            steps {
                echo 'Creating backup of current deployment...'
                bat """
                ssh %DEPLOY_SERVER% "rm -rf %BACKUP_PATH% && cp -r %DEPLOY_PATH% %BACKUP_PATH%"
                """
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying build to server...'
                
                bat """
                scp -r dist\\car_website\\browser\\* %DEPLOY_SERVER%:%DEPLOY_PATH%
                """
            }
        }

        stage('Post Deploy Verification') {
            steps {
                echo 'Checking deployment health...'

                bat """
                ssh %DEPLOY_SERVER% "test -f %DEPLOY_PATH%/index.html"
                """
            }
        }
    }

    post {

        success {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: "✅ SUCCESS: Jenkins Build #${env.BUILD_NUMBER}",
                body: """
Pipeline Status: SUCCESS

✔ Build completed successfully
✔ Deployment done on server
✔ Tests passed

Build Number: ${env.BUILD_NUMBER}
Job: ${env.JOB_NAME}
"""
            )
        }

        failure {
            script {
                echo "Pipeline failed. Rolling back deployment..."

                bat """
                ssh %DEPLOY_SERVER% "rm -rf %DEPLOY_PATH% && cp -r %BACKUP_PATH% %DEPLOY_PATH%"
                """
            }

            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: "❌ FAILED: Jenkins Build #${env.BUILD_NUMBER}",
                body: """
Pipeline Status: FAILED

❌ Build or deployment failed
🔁 Rollback executed automatically

Check Jenkins console output for exact error.

Build Number: ${env.BUILD_NUMBER}
Job: ${env.JOB_NAME}
"""
            )
        }
    }
}
