pipeline {
    agent any

    environment {

        BUILD_PATH = "dist/car_website/browser"

        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"

        DEPLOY_PATH = "/usr/share/nginx/html/car"

        // EC2 backup folder
        REMOTE_BACKUP = "/home/ec2-user/car_backups"

        // LOCAL backup folder (Windows Jenkins machine)
        LOCAL_BACKUP = "C:\\jenkins_backups\\car"

        KEY_PATH = "C:\\jenkins\\.ssh\\ec2-key.pem"

        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat "npx ng build --configuration production --base-href=/car/"
            }
        }

        stage('Verify Build') {
            steps {
                bat "dir %BUILD_PATH%"
            }
        }

        stage('Create LOCAL Backup') {
            steps {
                bat """
                echo Creating local backup...

                if not exist "%LOCAL_BACKUP%" (
                    mkdir "%LOCAL_BACKUP%"
                )

                set VERSION=%date:~-4%%date:~3,2%%date:~0,2%_%time:~0,2%%time:~3,2%%time:~6,2%
                set VERSION=%VERSION: =0%

                mkdir "%LOCAL_BACKUP%\\car_%VERSION%"

                xcopy "%BUILD_PATH%\\*" "%LOCAL_BACKUP%\\car_%VERSION%\\" /E /I /Y
                """
            }
        }

        stage('Fix SSH Key Permissions') {
            steps {
                bat '''
                icacls "C:\\jenkins\\.ssh\\ec2-key.pem" /inheritance:r
                icacls "C:\\jenkins\\.ssh\\ec2-key.pem" /grant:r "%USERNAME%:R"
                '''
            }
        }

        stage('Deploy + Remote Backup + Restart Nginx') {
            steps {
                bat '''
                echo Starting EC2 deployment...

                REM 1. Create backup on EC2
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP% "
                    sudo mkdir -p %REMOTE_BACKUP%/car_$(date +%Y%m%d_%H%M%S)
                    sudo cp -r %DEPLOY_PATH%/* %REMOTE_BACKUP%/car_$(date +%Y%m%d_%H%M%S)/ 2>/dev/null || true
                "

                REM 2. Clean old deployment
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP "
                    sudo rm -rf %DEPLOY_PATH%/*
                "

                REM 3. Deploy new build
                scp -i "%KEY_PATH%" -o StrictHostKeyChecking=no -r %BUILD_PATH%/. %EC2_USER%@%EC2_IP%:%DEPLOY_PATH%/

                REM 4. Restart nginx
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP "
                    sudo systemctl restart nginx
                "
                '''
            }
        }
    }

    post {

        success {
            emailext(
                to: "${EMAIL_TO}",
                subject: "SUCCESS: Angular deployed (EC2 + Local backup)",
                body: "Deployment successful. Local + EC2 backups created."
            )
        }

        failure {
            emailext(
                to: "${EMAIL_TO}",
                subject: "FAILED: Deployment",
                body: "Check Jenkins logs"
            )
        }
    }
}
