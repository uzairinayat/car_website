pipeline {
    agent any

    environment {
        SSH_SERVER = 'CarServer'
        REMOTE_DIR = '/var/www/html'
        EMAIL_TO = 'uzairinayat42@gmail.com'
    }

    stages {

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Test') {
            steps {
                bat 'npm test -- --watch=false'
            }
        }

        stage('Deploy') {
            steps {
                sshPublisher(publishers: [
                    sshPublisherDesc(
                        configName: SSH_SERVER,
                        transfers: [
                            sshTransfer(
                                sourceFiles: 'dist/**',
                                removePrefix: 'dist',
                                remoteDirectory: REMOTE_DIR,
                                execCommand: '''
                                    sudo rm -rf /var/www/html/*
                                    sudo cp -r * /var/www/html/
                                    sudo systemctl restart httpd
                                '''
                            )
                        ],
                        verbose: true
                    )
                ])
            }
        }
    }

    post {

        success {
            mail to: "${EMAIL_TO}",
            subject: "SUCCESS: Build Passed",
            body: "Deployment SUCCESS on EC2 🚀"
        }

        failure {
            mail to: "${EMAIL_TO}",
            subject: "FAILED: Build Broken",
            body: "Check Jenkins logs ❌"
        }
    }
}
