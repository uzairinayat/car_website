pipeline {
    agent any

    environment {
        APP_NAME = "car-website"
        TOMCAT_WEBAPPS = "C:\\Program Files\\Apache Software Foundation\\Tomcat 9.0\\webapps"
        EMAIL_TO = "uzairinayat42@gmail.com"   
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Deploy to Tomcat (Windows)') {
            steps {
                bat """
                echo Cleaning old deployment...
        
                rmdir /S /Q "%TOMCAT_WEBAPPS%\\%APP_NAME%" 
        
                mkdir "%TOMCAT_WEBAPPS%\\%APP_NAME%"
        
                echo Copying ONLY browser folder content...
        
                xcopy /E /Y /I dist\\car-website\\car_website\\browser\\* "%TOMCAT_WEBAPPS%\\%APP_NAME%"
        
                echo Deployment Done
                """
            }
        }
    }

    post {

        success {
            echo 'Deployment Successful 🎉'

            mail to: "${EMAIL_TO}",
                 subject: "✅ SUCCESS: ${APP_NAME} deployed",
                 body: """
Hello,

Your Angular app has been successfully deployed on Tomcat.

🌐 URL: http://localhost:8181/${APP_NAME}

Build: ${env.BUILD_URL}
"""
        }

        failure {
            echo 'Deployment Failed ❌'

            mail to: "${EMAIL_TO}",
                 subject: "❌ FAILED: ${APP_NAME} deployment",
                 body: """
Hello,

Your Jenkins pipeline failed.

Check details:
${env.BUILD_URL}
"""
        }
    }
}
