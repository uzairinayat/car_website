pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        TOMCAT_WEBAPPS = "C:\\Program Files\\Apache Software Foundation\\Tomcat 9.0\\webapps"
        BUILD_BROWSER = "dist\\car-website\\car_website\\browser"
        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Deploy DIRECTLY to Tomcat webapps (NO ROOT, NO FOLDER)') {
            steps {
                bat """
                echo =========================================
                echo Deploying browser files directly to webapps
                echo =========================================

                REM IMPORTANT: clean ONLY static files (NOT ROOT folder)
                
                del /Q "%TOMCAT_WEBAPPS%\\*.html"
                del /Q "%TOMCAT_WEBAPPS%\\*.js"
                del /Q "%TOMCAT_WEBAPPS%\\*.css"
                del /Q "%TOMCAT_WEBAPPS%\\*.ico"

                rmdir /S /Q "%TOMCAT_WEBAPPS%\\assets"

                echo Copying browser build files...

                xcopy /E /Y /I "%BUILD_BROWSER%\\*" "%TOMCAT_WEBAPPS%"

                echo Deployment completed directly into webapps root
                """
            }
        }
    }

    post {

        success {
            mail to: "${EMAIL_TO}",
                 subject: "✅ Angular Deployed to Tomcat ROOT",
                 body: """
SUCCESS 🎉

Angular app deployed directly into:
C:\\Program Files\\Apache Software Foundation\\Tomcat 9.0\\webapps

No ROOT folder used.

URL:
http://localhost:8181/
"""
        }

        failure {
            mail to: "${EMAIL_TO}",
                 subject: "❌ Deployment Failed",
                 body: """
Pipeline failed. Check Jenkins logs:
${env.BUILD_URL}
"""
        }
    }
}
