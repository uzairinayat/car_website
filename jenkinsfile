pipeline {
    agent any

    environment {
        SERVER = "10.1.1.221"
        USER = "root"
        DEPLOY_PATH = "/root/Desktop/apache-tomcat-9.0.20/webapps"
        EMAIL = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/uzairinayat/car_website'
            }
        }

        stage('Install') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test || true'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                scp -o StrictHostKeyChecking=no -r dist/* root@10.1.1.221:/root/Desktop/apache-tomcat-9.0.20/webapps
                '''
            }
        }
    }

    post {
        success {
            emailext (
                subject: "CI/CD SUCCESS 🚀",
                body: "Your application has been built, tested, and deployed successfully.",
                to: "${EMAIL}"
            )
        }

        failure {
            emailext (
                subject: "CI/CD FAILED ❌",
                body: "Pipeline failed. Check Jenkins logs.",
                to: "${EMAIL}"
            )
        }
    }
}
