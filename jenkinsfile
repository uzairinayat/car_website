pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building the app'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing the app'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying the app'
            }
        }
    }

    post {
        success {
            mail to: 'uzairinayat42@gmail.com',
                 subject: "Jenkins Pipeline Success: Deploy Completed",
                 body: "Good news! Your Jenkins pipeline has successfully completed all stages including deployment."
        }

        failure {
            mail to: 'uzairinayat42@gmail.com',
                 subject: "Jenkins Pipeline Failed",
                 body: "Your Jenkins pipeline has failed. Please check the console output for details."
        }
    }
}
