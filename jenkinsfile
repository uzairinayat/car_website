pipeline {
    agent any

    environment {
        TOMCAT_HOME = "C:\\Program Files\\Apache Software Foundation\\Tomcat 9.0"
        DEPLOY_PATH = "${TOMCAT_HOME}\\webapps\\car"

        BUILD_PATH = "dist\\car_website\\browser"

        // ✅ BACKUP FOLDER
        BACKUP_PATH = "C:\\jenkins_backups\\car"

        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat "npx ng build --configuration production --base-href=/car/"
            }
        }

        stage('Verify Build Output') {
            steps {
                bat "dir dist\\car_website\\browser"
            }
        }

        // ✅ BACKUP OLD DEPLOYMENT INSTEAD OF DELETING
        stage('Backup Old Deployment') {
            steps {
                bat """
                if exist "%DEPLOY_PATH%" (
                    for /f "tokens=1-4 delims=/ " %%a in ('date /t') do set d=%%a-%%b-%%c
                    for /f "tokens=1-2 delims=: " %%a in ('time /t') do set t=%%a-%%b

                    set BACKUP_FOLDER=%BACKUP_PATH%\\backup_%DATE:~-4%%DATE:~4,2%%DATE:~7,2%_%TIME:~0,2%%TIME:~3,2%

                    mkdir "%BACKUP_PATH%" 2>nul
                    mkdir "%BACKUP_FOLDER%"

                    xcopy "%DEPLOY_PATH%\\*" "%BACKUP_FOLDER%\\" /E /I /Y

                    rmdir /s /q "%DEPLOY_PATH%"
                )
                """
            }
        }

        stage('Deploy to Tomcat Webapps') {
            steps {
                bat """
                xcopy "%BUILD_PATH%\\*" "%DEPLOY_PATH%\\" /E /I /Y
                """
            }
        }

        stage('Restart Tomcat') {
            steps {
                bat """
                net stop Tomcat9
                net start Tomcat9
                """
            }
        }
    }

    post {
        success {
            emailext(
                to: "${EMAIL_TO}",
                subject: "SUCCESS: Jenkins Deployment",
                body: "Deployment successful. Backup created and new build deployed."
            )
        }

        failure {
            emailext(
                to: "${EMAIL_TO}",
                subject: "FAILED: Jenkins Deployment",
                body: "Pipeline failed. Check Jenkins logs."
            )
        }
    }
}
