pipeline {
    agent any

    environment {
        TOMCAT_WEBAPPS = "C:\\Program Files\\Apache Software Foundation\\Tomcat 9.0\\webapps"
        APP_NAME = "CAR"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Deploy to Local Tomcat') {
            steps {
                script {
                    // Angular output path (adjust if needed)
                    def buildPath = "C:/ProgramData/Jenkins/.jenkins/workspace/car/dist/car_website/browser"

                    // Target deployment folder (NOT ROOT)
                    def targetPath = "${env.TOMCAT_WEBAPPS}\\${env.APP_NAME}"

                    bat """
                        echo Deploying to Tomcat...

                        REM Remove previous deployment
                        if exist "${targetPath}" (
                            rmdir /s /q "${targetPath}"
                        )

                        REM Copy new build to Tomcat webapps folder
                        robocopy "${buildPath}" "${targetPath}" /E

                        echo Deployment completed.
                    """
                }
            }
        }
    }
}
