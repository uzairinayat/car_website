pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        APP_NAME = "car-website"
        TOMCAT_DEPLOY = "C:\\Program Files\\Apache Software Foundation\\Tomcat 9.0\\webapps\\car-website"
        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Deploy ONLY browser folder') {
            steps {
                bat """
                echo ================================
                echo Deploying ONLY browser folder
                echo ================================

                REM Remove old deployment
                rmdir /S /Q "%TOMCAT_DEPLOY%"

                REM Create fresh folder
                mkdir "%TOMCAT_DEPLOY%"

                REM Copy ONLY browser content
                xcopy /E /Y /I dist\\car-website\\car_website\\browser\\* "%TOMCAT_DEPLOY%"

                echo Deployment Completed
                """
            }
        }
    }

    post {

        success {
            mail to: "${EMAIL_TO}",
                 subject: "✅ SUCCESS: Car Website Deployed",
                 body: """
Deployment Successful 🎉

App: ${APP_NAME}
URL: http://localhost:8181/${APP_NAME}

Deployed ONLY browser folder into Tomcat webapps.
"""
        }

        failure {
            mail to: "${EMAIL_TO}",
                 subject: "❌ FAILED: Car Website Deployment",
                 body: """
Deployment Failed ❌

Check Jenkins logs:
${env.BUILD_URL}
"""
        }
    }
}
