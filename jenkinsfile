pipeline {
    agent any

    environment {
        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Deploy') {
    steps {
        echo 'Deploying to EC2...'

        sshagent(['ec2-ssh']) {
            bat '''
            ssh -o StrictHostKeyChecking=no ec2-user@34.196.168.199 "sudo rm -rf /var/www/html/*"

            scp -o StrictHostKeyChecking=no -r dist/car_website/browser/* ec2-user@34.196.168.199:/tmp/

            ssh -o StrictHostKeyChecking=no ec2-user@34.196.168.199 "sudo cp -r /tmp/* /var/www/html/ && sudo systemctl restart nginx"
            '''
        }
    }
}
    }

    post {
        success {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: 'Deployment Success 🚀',
                body: 'car_website deployed successfully on EC2'
            )
        }

        failure {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: 'Deployment Failed ❌',
                body: 'Check Jenkins logs'
            )
        }
    }
}
