pipeline {
    agent any

    environment {
        DEPLOY_PATH = "\\\\10.1.1.251\\TomcatWebapps\\CAR"
        APP_NAME = "CAR"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat 'npm run build -- --configuration production --base-href /CAR/'
            }
        }

        stage('Clean Old Deployment') {
            steps {
                bat """
                if exist "%DEPLOY_PATH%" rmdir /S /Q "%DEPLOY_PATH%"
                mkdir "%DEPLOY_PATH%"
                """
            }
        }

        stage('Deploy to Tomcat Server') {
            steps {
                bat """
                xcopy /E /I /Y dist\\car_website\\* "%DEPLOY_PATH%\\"
                """
            }
        }
    }

    post {

        success {
            echo 'Deployment Successful'

            emailext(
                to: 'youremail@gmail.com',
                subject: "SUCCESS: ${APP_NAME} Deployed Successfully",
                body: """
Hello,

Your application ${APP_NAME} has been deployed successfully.

Server: 10.1.1.251
Path: ${DEPLOY_PATH}
URL: http://10.1.1.251:8080/CAR/

Regards,
Jenkins
"""
            )
        }

        failure {
            echo 'Deployment Failed'

            emailext(
                to: 'youremail@gmail.com',
                subject: "FAILED: ${APP_NAME} Deployment",
                body: """
Hello,

Deployment FAILED for ${APP_NAME}.

Please check Jenkins logs for details.

Server: 10.1.1.251

Regards,
Jenkins
"""
            )
        }
    }
}
