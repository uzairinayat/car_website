pipeline {
    agent any

    environment {
        BUILD_PATH = "dist/car_website/browser"

        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"

        DEPLOY_PATH = "/usr/share/nginx/html/car"

        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat "npx ng build --configuration production --base-href=/car/"
            }
        }

        stage('Deploy to EC2 Nginx') {
            steps {
                sshagent(['ec2-ssh']) {
                    bat """
                    echo Deploying to Nginx server...

                    scp -o StrictHostKeyChecking=no -r %BUILD_PATH%/* %EC2_USER%@%EC2_IP%:%DEPLOY_PATH%/

                    ssh -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP "sudo systemctl restart nginx"
                    """
                }
            }
        }
    }

    post {
        success {
            emailext(
                to: "${EMAIL_TO}",
                subject: "SUCCESS: Angular Deployed to Nginx",
                body: "Deployment successful on AWS EC2 Nginx server"
            )
        }

        failure {
            emailext(
                to: "${EMAIL_TO}",
                subject: "FAILED: Deployment",
                body: "Check Jenkins logs"
            )
        }
    }
}
