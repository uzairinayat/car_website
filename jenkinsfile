pipeline {
    agent any

    environment {

        BUILD_PATH = "dist/car_website/browser"

        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"

        DEPLOY_PATH = "/usr/share/nginx/html/car"

        BACKUP_PATH = "/home/ec2-user/car_backups"

        KEY_PATH = "C:\\jenkins\\.ssh\\ec2-key.pem"

        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat "npx ng build --configuration production --base-href=/car/"
            }
        }

        stage('Verify Build') {
            steps {
                bat "dir %BUILD_PATH%"
            }
        }

        stage('Fix SSH Key Permissions') {
            steps {
                bat '''
                icacls "C:\\jenkins\\.ssh\\ec2-key.pem" /inheritance:r
                icacls "C:\\jenkins\\.ssh\\ec2-key.pem" /grant:r "%USERNAME%:R"
                '''
            }
        }

        stage('Backup + Deploy to EC2 Nginx') {
            steps {
                bat '''
                echo Starting deployment...

                REM Create backup folder on EC2 (versioned backup)
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP% "
                    mkdir -p %BACKUP_PATH%/car_$(date +%Y%m%d_%H%M%S)
                    cp -r %DEPLOY_PATH%/* %BACKUP_PATH%/car_$(date +%Y%m%d_%H%M%S)/ 2>/dev/null || true
                "

                REM Clean old deployment + deploy new build
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP "
                    sudo rm -rf %DEPLOY_PATH%/*
                "

                scp -i "%KEY_PATH%" -o StrictHostKeyChecking=no -r %BUILD_PATH%/. %EC2_USER%@%EC2_IP%:%DEPLOY_PATH%/

                REM Restart nginx
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP "
                    sudo systemctl restart nginx
                "
                '''
            }
        }
    }

    post {

        success {
            emailext(
                to: "${EMAIL_TO}",
                subject: "SUCCESS: Angular deployed to AWS Nginx",
                body: "Deployment successful. App live at http://${EC2_IP}/car/"
            )
        }

        failure {
            emailext(
                to: "${EMAIL_TO}",
                subject: "FAILED: Deployment",
                body: "Check Jenkins logs"
            )
        }
    }
}
