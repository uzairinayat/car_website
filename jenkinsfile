pipeline {
    agent any

    environment {
        TOMCAT_HOME = "C:\\Program Files\\Apache Software Foundation\\Tomcat 9.0"
        DEPLOY_PATH = "${TOMCAT_HOME}\\webapps\\car"

        // ✅ FIXED PATH (IMPORTANT)
        BUILD_PATH = "dist\\car_website\\browser"

        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat "npx ng build --configuration production --base-href=/car/"
            }
        }

        stage('Verify Build Output') {
            steps {
                bat "dir dist\\car_website\\browser"
            }
        }

        stage('Clean Old Deployment') {
            steps {
                bat """
                if exist "%DEPLOY_PATH%" (
                    rmdir /s /q "%DEPLOY_PATH%"
                )
                """
            }
        }

        stage('Deploy to Tomcat Webapps') {
            steps {
                bat """
                xcopy "%BUILD_PATH%\\*" "%DEPLOY_PATH%\\" /E /I /Y
                """
            }
        }

        stage('Restart Tomcat') {
            steps {
                bat """
                net stop Tomcat9
                net start Tomcat9
                """
            }
        }
    }

    post {
        success {
            mail to: "${EMAIL_TO}",
            subject: "SUCCESS: Tomcat Deployment",
            body: "Deployment SUCCESSFUL 🚀 \nhttp://localhost:8181/car/"
        }

        failure {
            mail to: "${EMAIL_TO}",
            subject: "FAILED: Tomcat Deployment",
            body: "Check Jenkins logs for errors."
        }
    }
}
