pipeline {
    agent any

    environment {
        TOMCAT_WEBAPPS = "C:\\Program Files\\Apache Software Foundation\\Tomcat 9.0\\webapps"
        BUILD_FOLDER = "dist\\car-website\\car_website\\browser"
        EMAIL_TO = "uzairinayat42@example.com"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Build Step (SKIPPED - already built)') {
            steps {
                echo "Skipping build (No NodeJS used)"
                echo "Assuming browser folder already exists"
            }
        }

        stage('Deploy Browser Files to Tomcat ROOT') {
            steps {
                bat """
                echo ================================
                echo Deploying Angular browser files
                echo WITHOUT ROOT or folder name
                echo ================================

                REM Clean only old frontend files (safe cleanup)
                del /Q "%TOMCAT_WEBAPPS%\\*.html"
                del /Q "%TOMCAT_WEBAPPS%\\*.js"
                del /Q "%TOMCAT_WEBAPPS%\\*.css"
                del /Q "%TOMCAT_WEBAPPS%\\*.ico" 2>nul
                rmdir /S /Q "%TOMCAT_WEBAPPS%\\assets" 2>nul

                REM Copy browser build directly into webapps root
                xcopy /E /Y /I "%BUILD_FOLDER%\\*" "%TOMCAT_WEBAPPS%"

                echo Deployment Completed Successfully
                """
            }
        }
    }

    post {

        success {
            mail to: "${EMAIL_TO}",
                 subject: "✅ Angular Deployed Successfully (Tomcat ROOT)",
                 body: """
SUCCESS 🎉

Angular browser build deployed directly into:

${TOMCAT_WEBAPPS}

No ROOT folder used.
No NodeJS used.

URL:
http://localhost:8181/
"""
        }

        failure {
            mail to: "${EMAIL_TO}",
                 subject: "❌ Deployment Failed",
                 body: """
Pipeline FAILED ❌

Check Jenkins logs:
${env.BUILD_URL}
"""
        }
    }
}
