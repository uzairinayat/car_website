pipeline {
    agent any

    environment {
        SERVER_HOST = "10.1.1.221"
        SERVER_USER = "root"
        SERVER_PASS = "Comp@123"

        TOMCAT_PATH = "/root/Desktop/apache-tomcat-9.0.20/webapps"
        LOCAL_BUILD = "dist/car_website/browser"
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo 'Cloning GitHub repository...'
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing npm dependencies...'
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                echo 'Building Angular project...'
                bat 'npm run build -- --configuration production'
            }
        }

       stage('Test') {
    steps {
        echo 'Skipping tests for now (fix later)'
    }
}
stage('Test WinSCP Connection') {
    steps {
        bat """
        "C:\\Program Files (x86)\\WinSCP\\WinSCP.com" /command ^
        "open sftp://root:Comp%40123@10.1.1.221 -hostkey=\"ssh-ed25519 255 dqYIyVzCtK1+a2hZmjhdhG9A3dMhoY1l5xfRrCNm97I\"" ^
        "ls /root/Desktop/apache-tomcat-9.0.20/webapps" ^
        "exit"
        """
    }
}

        stage('Create WinSCP Script') {
            steps {
                echo 'Creating deploy script...'

                writeFile file: 'deploy.txt', text: """
open sftp://${SERVER_USER}:${SERVER_PASS}@${SERVER_HOST}
option batch abort
option confirm off
rm -rf ${TOMCAT_PATH}/*
put -r ${LOCAL_BUILD}/* ${TOMCAT_PATH}/
exit
"""
            }
        }

       stage('Deploy using WinSCP') {
    steps {
        echo 'Deploying via WinSCP...'

        bat """
        "C:\\Program Files (x86)\\WinSCP\\WinSCP.com" /command ^
        "open sftp://root:Comp@123@10.1.1.221 -hostkey=\\"ssh-ed25519 255 dqYIyVzCtK1+a2hZmjhdhG9A3dMhoY1l5xfRrCNm97I\\"" ^
        "rm /root/Desktop/apache-tomcat-9.0.20/webapps/*" ^
        "put -r dist/car_website/browser/* /root/Desktop/apache-tomcat-9.0.20/webapps/" ^
        "exit"
        """
    }
}
        stage('Verify Deployment') {
            steps {
                echo 'Verifying deployment...'

                bat """
                "C:\\Program Files (x86)\\WinSCP\\WinSCP.com" /command ^
                "open sftp://${SERVER_USER}:${SERVER_PASS}@${SERVER_HOST}" ^
                "ls ${TOMCAT_PATH}" ^
                "exit"
                """
            }
        }
    }

    post {

        success {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: "✅ SUCCESS: Build #${env.BUILD_NUMBER}",
                body: """
Pipeline SUCCESS

✔ Angular build completed
✔ Deployed via WinSCP
✔ Server updated successfully

URL:
http://${SERVER_HOST}:8080/
"""
            )
        }

        failure {
            emailext(
                to: 'uzairinayat42@gmail.com',
                subject: "❌ FAILED: Build #${env.BUILD_NUMBER}",
                body: """
Pipeline FAILED

❌ Something went wrong in build or deployment

Check Jenkins logs for details.

Server: ${SERVER_HOST}
"""
            )
        }
    }
}
