pipeline {
    agent any

    environment {

        BUILD_PATH = "dist\\car_website\\browser"

        EC2_IP = "34.196.168.199"
        EC2_USER = "ec2-user"

        DEPLOY_PATH = "/usr/share/nginx/html/car"

        KEY_PATH = "C:\\jenkins\\.ssh\\ec2-key.pem"

        EMAIL_TO = "uzairinayat42@gmail.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                bat "npx ng build --configuration production --base-href=/car/"
            }
        }

        stage('Verify Build') {
            steps {
                bat "dir %BUILD_PATH%"
            }
        }

        stage('Fix Key Permissions (IMPORTANT)') {
            steps {
                bat """
                echo Fixing SSH key permissions...

                icacls "%KEY_PATH%" /inheritance:r
                icacls "%KEY_PATH%" /grant:r "%USERNAME%:R"
                """
            }
        }

        stage('Deploy to AWS Nginx') {
            steps {
                bat """
                echo ===== START DEPLOYMENT =====

                REM Upload build
                scp -i "%KEY_PATH%" -o StrictHostKeyChecking=no -r %BUILD_PATH%/. %EC2_USER%@%EC2_IP%:%DEPLOY_PATH%/

                REM Restart nginx
                ssh -i "%KEY_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_IP% "sudo systemctl restart nginx || systemctl restart nginx"

                echo ===== DEPLOYMENT COMPLETE =====
                """
            }
        }
    }

    post {
        success {
            emailext(
                to: "${EMAIL_TO}",
                subject: "SUCCESS: AWS Deployment",
                body: "Angular app deployed successfully to Nginx"
            )
        }

        failure {
            emailext(
                to: "${EMAIL_TO}",
                subject: "FAILED: AWS Deployment",
                body: "Check Jenkins logs"
            )
        }
    }
}
