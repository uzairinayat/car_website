pipeline {
    agent any

    environment {
        SSH_SERVER = 'CarServer'
        REMOTE_DIR = '/var/www/html'
        EMAIL_TO = 'uzairinayat42@gmail.com'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/uzairinayat/car_website.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build --prod'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test -- --watch=false --browsers=ChromeHeadless'
            }
        }

        stage('Deploy') {
            steps {
                sshPublisher(publishers: [
                    sshPublisherDesc(
                        configName: SSH_SERVER,
                        transfers: [
                            sshTransfer(
                                sourceFiles: 'dist/**',
                                removePrefix: 'dist',
                                remoteDirectory: REMOTE_DIR,
                                execCommand: '''
                                    sudo rm -rf /var/www/html/*
                                    sudo cp -r * /var/www/html/
                                    sudo systemctl restart httpd
                                '''
                            )
                        ],
                        verbose: true
                    )
                ])
            }
        }
    }

    post {

        success {
            echo 'Pipeline SUCCESS ✅'

            mail to: "${EMAIL_TO}",
                 subject: "SUCCESS: Jenkins Build Passed ✔",
                 body: """
Hello,

Your Jenkins pipeline completed successfully 🎉

Project: car_website
Status: SUCCESS
Server: CarServer
Deployment: Done

Regards,
Jenkins CI/CD
"""
        }

        failure {
            echo 'Pipeline FAILED ❌'

            mail to: "${EMAIL_TO}",
                 subject: "FAILED: Jenkins Build ❌",
                 body: """
Hello,

Your Jenkins pipeline has failed.

Project: car_website
Status: FAILED
Please check Jenkins logs for details.

Regards,
Jenkins CI/CD
"""
        }
    }
}
